{
  "expo": {
    "name": "Vehiqo",
    "slug": "vehiqo",
    "scheme": "vehiqo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "robertmarianstec",
    "plugins": ["expo-localization", "expo-router", "expo-sqlite", "expo-font"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "13c2ee88-4960-4868-95cf-460c412c83b7"
      }
    }
  }
}
